{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "repositories": ["borkedbydesign/debian-repo"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions/helix\\.json$/"],
      "matchStrings": ["\"version\":\\s*\"(?<currentValue>.*?)\""],
      "depNameTemplate": "helix-editor/helix",
      "packageNameTemplate": "helix-editor/helix",
      "datasourceTemplate": "github-releases"
    }
  ]
}
